# ==============================================================================
# Trip Planner Environment Configuration
# Copy this file to .env and configure your desired model and API keys:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTION 1: OpenAI (Default)
# ------------------------------------------------------------------------------
MODEL=gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key_here
# Optional: Set a specific organization or base URL if using enterprise proxy
# OPENAI_API_BASE=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# OPTION 2: Groq (Ultra-fast Llama inference)
# To use: uncomment the lines below and provide your Groq API key
# ------------------------------------------------------------------------------
# MODEL=groq/llama-3.3-70b-versatile
# GROQ_API_KEY=your_groq_api_key_here

# ------------------------------------------------------------------------------
# OPTION 3: Ollama (100% Local, Offline & Free)
# To use: run `ollama run llama3.1` in your terminal and uncomment below
# ------------------------------------------------------------------------------
# MODEL=ollama/llama3.1
# OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# OPTION 4: Google Gemini
# ------------------------------------------------------------------------------
# MODEL=gemini/gemini-2.0-flash
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# Optional Search Tools (SerperDevTool)
# If provided, the Destination Researcher will execute live web searches.
# If omitted or left as placeholder, the project safely runs offline with LLM knowledge.
# Free 2,500 queries at: https://serper.dev
# ------------------------------------------------------------------------------
SERPER_API_KEY=
